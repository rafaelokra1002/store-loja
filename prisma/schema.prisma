generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("USER")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float
  discount    Float    @default(0)
  image       String   @default("")
  category    String
  driveLink   String   @default("")
  stock       Int      @default(-1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]

  @@index([category])
  @@index([name])
}

model Order {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  payerName       String
  payerEmail      String
  payerDocument   String
  amount          Float
  transactionId   String   @unique
  misticPayId     String   @default("")
  status          String   @default("PENDENTE")
  qrCodeBase64    String   @default("")
  copyPaste       String   @default("")
  downloadToken   String   @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([transactionId])
  @@index([downloadToken])
  @@index([status])
}

model SiteSettings {
  id              String  @id @default("main")
  storeName       String  @default("VegaStore")
  storeSlogan     String  @default("A Melhor Loja de Bots e Automação!")
  storeSubtitle   String  @default("Automatize seu negócio hoje com nossos serviços!")
  storeLogo       String  @default("")
  storeFavicon    String  @default("")
  heroEnabled     Boolean @default(true)
  heroBadgeText   String  @default("VegaStore Solutions")
  accentColor     String  @default("#00ff88")
  footerText      String  @default("Todos os direitos reservados.")
  contactEmail    String  @default("")
  contactWhatsapp String  @default("")
  socialDiscord   String  @default("")
  socialInstagram String  @default("")
  socialTelegram  String  @default("")
  updatedAt       DateTime @updatedAt
}
